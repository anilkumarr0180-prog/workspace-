# Supabase Project Configuration
# Replace these placeholder values with your project credentials from your Supabase dashboard:
# Project Settings -> API (or Project Settings -> Data API)

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable / Anon Key (publicly safe client key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: Legacy Anon Key fallback alias if your setup uses NEXT_PUBLIC_SUPABASE_ANON_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay Payment Gateway Configuration
# Environment: 'test' or 'live'. Defaults to 'test' if omitted.
# In 'test' mode, NEXT_PUBLIC_RAZORPAY_KEY_ID must start with 'rzp_test_'.
# In 'live' mode, NEXT_PUBLIC_RAZORPAY_KEY_ID must start with 'rzp_live_', and RAZORPAY_WEBHOOK_SECRET is required.
RAZORPAY_ENVIRONMENT=test

# Key ID: Safe for client exposure in Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Key Secret: STRICTLY SERVER-SIDE. Never expose with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook Secret: Used to cryptographically verify webhook calls (Required in live mode)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Optional Currency: Defaults to INR for standard test accounts; set to USD if international currency is enabled
RAZORPAY_CURRENCY=INR

# Local Email Development (Mailpit SMTP - Server-side only)
LOCAL_SMTP_HOST=127.0.0.1
LOCAL_SMTP_PORT=54325
LOCAL_SMTP_SECURE=false
LOCAL_EMAIL_FROM="Workspace <no-reply@workspace.local>"

# Email Provider Configuration (Server-side only)
# Values: 'smtp' (default in production) | 'mailpit' (default in development) | 'resend' | 'test'
EMAIL_PROVIDER=smtp

# Production Email Configuration (Nodemailer SMTP - Server-side only)
# Required in NODE_ENV=production or when EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Workspace <notifications@workspace.com>"
# Optional: Enforce STARTTLS (defaults to true on non-465 ports)
# SMTP_REQUIRE_TLS=true

# Legacy / Alternative Email Configuration (Resend API - Server-side only)
# Required only if EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Workspace <notifications@workspace.com>"

# Email Worker Authentication Secret (Server-side only)
# Cryptographically random token (32+ chars) used to authorize Vercel Cron and pg_net worker requests.
CRON_SECRET=your_random_32_byte_cron_secret_here

# Administrative Health Endpoint Secret (Server-side only)
# Dedicated secret for /api/admin/health diagnostics. Required for administrative monitoring.
# Strongly recommended: Configure an independent, dedicated 32-byte secret in hosted/production environments (e.g. Vercel)
# to enforce separation of privilege between external uptime monitoring probes and internal cron jobs.
ADMIN_HEALTH_SECRET=your_random_32_byte_admin_health_secret_here

# E2E Test Suite Configuration (Playwright)
# E2E tests are strictly prohibited from targeting hosted or production Supabase (*.supabase.co).
# For local E2E testing, ensure local Supabase is running (http://127.0.0.1:54321).
# PLAYWRIGHT_SUPABASE_URL=http://127.0.0.1:54321
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
