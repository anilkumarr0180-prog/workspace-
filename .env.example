# Supabase Project Configuration
# Replace these placeholder values with your project credentials from your Supabase dashboard:
# Project Settings -> API (or Project Settings -> Data API)

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable / Anon Key (publicly safe client key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: Legacy Anon Key fallback alias if your setup uses NEXT_PUBLIC_SUPABASE_ANON_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay Payment Gateway Configuration
# Environment: 'test' or 'live'. Defaults to 'test' if omitted.
# In 'test' mode, NEXT_PUBLIC_RAZORPAY_KEY_ID must start with 'rzp_test_'.
# In 'live' mode, NEXT_PUBLIC_RAZORPAY_KEY_ID must start with 'rzp_live_', and RAZORPAY_WEBHOOK_SECRET is required.
RAZORPAY_ENVIRONMENT=test

# Key ID: Safe for client exposure in Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Key Secret: STRICTLY SERVER-SIDE. Never expose with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook Secret: Used to cryptographically verify webhook calls (Required in live mode)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Optional Currency: Defaults to INR for standard test accounts; set to USD if international currency is enabled
RAZORPAY_CURRENCY=INR

# Local Email Development (Mailpit SMTP - Server-side only)
LOCAL_SMTP_HOST=127.0.0.1
LOCAL_SMTP_PORT=54325
LOCAL_SMTP_SECURE=false
LOCAL_EMAIL_FROM="Workspace <no-reply@workspace.local>"

# Email Provider Configuration (Server-side only)
# Values: 'mailpit' (default in development) | 'resend' (required in production) | 'test'
EMAIL_PROVIDER=mailpit

# Production Email Configuration (Resend API - Server-side only)
# Required when EMAIL_PROVIDER=resend or in NODE_ENV=production
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Workspace <notifications@workspace.com>"

# Email Worker Authentication Secret (Server-side only)
# Cryptographically random token (32+ chars) used to authorize Vercel Cron and pg_net worker requests.
CRON_SECRET=your_random_32_byte_cron_secret_here


